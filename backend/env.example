# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local install:      mongodb://127.0.0.1:27017/nandini_unique
# MongoDB Atlas (free cloud tier): mongodb+srv://<user>:<password>@cluster.mongodb.net/nandini_unique
MONGO_URI=mongodb://127.0.0.1:27017/nandini_unique

# Port the API server runs on
PORT=5000

# Secret key used to sign JWT login tokens - change this to any long random string
JWT_SECRET=change_this_to_a_long_random_secret_string

# Address of the running frontend (used for CORS + links in emails/whatsapp messages)
FRONTEND_URL=http://localhost:5500

# ---------- Email (customer queries / order emails) ----------
# Works with any SMTP provider. Example below uses Gmail with an "App Password"
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-shop-email@gmail.com
SMTP_PASS=your_gmail_app_password
STORE_EMAIL=your-shop-email@gmail.com

# ---------- WhatsApp ----------
# Simple mode (default, no signup needed): the site generates "click to chat"
# wa.me links using the number below, so the owner/customer can message each other directly.
STORE_WHATSAPP_NUMBER=919999999999

# Advanced mode (optional): to send AUTOMATIC WhatsApp order-status updates instead of just
# links, sign up for the Twilio WhatsApp Sandbox/API (https://www.twilio.com/whatsapp) and fill
# these in. Leave blank to keep using simple click-to-chat mode only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------- Payments ----------
# This starter ships with a manual UTR/Transaction-ID flow (customer pays via UPI/QR or bank
# transfer and enters the reference number, which the owner verifies from the admin panel).
# To add real online payments later, sign up for Razorpay (https://razorpay.com) and put the keys
# here, then follow the note in routes/orderRoutes.js
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
